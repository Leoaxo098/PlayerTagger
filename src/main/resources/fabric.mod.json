{
  "schemaVersion": 1,
  "id": "playertagger",
  "version": "${version}",
  "name": "PlayerTagger",
  "description": "Recognize tagged players with a colored outline that respects opaque blocks and invisibility.",
  "authors": [
    {
      "name": "Leoaxo098",
      "contact": {
        "homepage": "https://github.com/Leoaxo098"
      }
    }
  ],
  "contact": {
    "sources": "https://github.com/Leoaxo098/PlayerTagger"
  },
  "license": "MIT",
  "icon": "assets/playertagger/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.playertagger.PlayerTaggerClient"
    ]
  },
  "mixins": [
    "playertagger.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
